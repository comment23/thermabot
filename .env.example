# thermabot environment. Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Every variable thermabot reads is listed here (thermabot/config.py: Env).
# Behaviour (thermostat entity, rooms, people, bands, schedule) is NOT configured here: it
# lives in the database and is edited on the Settings page. A fresh install starts in
# "SETUP NEEDED" and never writes to Home Assistant until a thermostat is configured.

# --- Home Assistant (required)
# Base URL of Home Assistant as seen from the container.
HA_URL=http://homeassistant.local:8123
# Long-lived access token of a NON-admin HA user created for the bot.
HA_TOKEN=replace-with-a-long-lived-access-token

# --- Heartbeat for the HA watchdog (recommended)
# URL of the HA webhook automation `thermabot_heartbeat` (deploy/ha/). Empty = no heartbeat.
HEARTBEAT_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/replace-with-webhook-id

# --- InfluxDB (optional: model history + write-back)
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=home
# Read token for the bucket HA's InfluxDB integration writes to. Empty = local samples only.
INFLUX_READ_TOKEN=
# Write token for the thermabot bucket. Empty = no write-back.
INFLUX_WRITE_TOKEN=
INFLUX_READ_BUCKET=ha_hvac
INFLUX_WRITE_BUCKET=thermabot

# --- Alerts (optional)
# Webhook that receives alert/summary JSON envelopes (POST; ALERT_WEBHOOK_TOKEN is sent as a bearer token).
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# --- Monitoring token (optional)
# A token that may only GET /healthz and /api/status (e.g. for an external monitor).
BOB_TOKEN=

# --- Runtime
TZ=America/New_York
LOG_LEVEL=INFO

# --- HVAC sensors, one-time seed (optional; v0.6.1)
# Only for a settings row saved before v0.3.0 that has no HVAC sensors stored yet. On start,
# if that row has no `sensors` section and any of these are set, they are stored into the row
# once (updated_by migration-v0.6.1); after that the row wins and these are ignored. New
# installs pick sensors in the setup wizard instead. Empty = not set.
THERMABOT_SENSOR_BLOWER=
THERMABOT_SENSOR_COMPRESSOR=
THERMABOT_SENSOR_OUTDOOR=
# e.g. THERMABOT_SENSOR_OUTDOOR=sensor.outdoor_temperature
# Inside the container these are fixed; change only when running outside Docker.
DATA_DIR=/data
PORT=8095
